#version 450

layout(local_size_x = 256) in;

layout(std430, binding = 0) buffer Out { uint data[]; };

layout(push_constant) uniform Push { uint count; uint seed; } push;

void main()
{
   uint i = gl_GlobalInvocationID.x;
   if (i >= push.count)
      return;

   /* Cheap but order-dependent arithmetic so a partially executed or
    * mis-dispatched workgroup produces a wrong value rather than a plausible one. */
   uint v = i ^ push.seed;
   for (uint k = 0; k < 32; ++k)
      v = v * 1664525u + 1013904223u;
   data[i] = v;
}
